# Dependencies
node_modules/

# Build output
dist/

# Node compile cache — pnpm 10 sets NODE_COMPILE_CACHE, so any install
# or script run drops a version-keyed cache dir here.
node-compile-cache/

# Environment
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Smithery
.smithery/

# Claude Code worktrees
.claude/worktrees/

# MCPB desktop-extension bundle output
*.mcpb

# Demo-video pipeline output (defaults to os.tmpdir(); this catches the case
# where a developer points outputDir inside the repo).
*.mp4
*.mp3
*.wav
